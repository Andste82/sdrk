{
  "sdrk": 1,
  "name": "ssb-receiver",
  "description": "Receive one single-sideband voice channel (USB or LSB) with a power squelch and an automatic gain control and output 48 kHz audio.",
  "settings": {
    "precision": "f32",
    "max_chunk": 4096
  },
  "inputs": {
    "rf": {
      "format": "cu8",
      "rate_hz": 2400000,
      "description": "RTL-SDR IQ"
    }
  },
  "nodes": {
    "agc": {
      "kind": "agc"
    },
    "audio_filter": {
      "kind": "biquad",
      "params": {
        "cutoff_hz": 2800,
        "order": 4,
        "response": "lowpass"
      }
    },
    "demod": {
      "kind": "ssb_demod",
      "params": {
        "sideband": "usb"
      }
    },
    "gate": {
      "kind": "squelch",
      "params": {
        "threshold_db": -50
      }
    },
    "tune": {
      "kind": "ddc",
      "params": {
        "cutoff_hz": 4000,
        "decimation": 50,
        "max_taps": 8192,
        "transition_hz": 2000
      }
    }
  },
  "edges": [
    {
      "from": "rf",
      "to": "tune"
    },
    {
      "from": "tune",
      "to": "gate"
    },
    {
      "from": "gate",
      "to": "agc"
    },
    {
      "from": "agc",
      "to": "demod"
    },
    {
      "from": "demod",
      "to": "audio_filter"
    },
    {
      "from": "audio_filter",
      "to": "audio"
    }
  ],
  "outputs": {
    "audio": {
      "type": "stream",
      "capacity": 16384,
      "drop": "error"
    }
  }
}
