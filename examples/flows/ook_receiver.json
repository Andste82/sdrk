{
  "sdrk": 1,
  "name": "ook-receiver",
  "description": "Receive on-off keyed packets of the test framing at 2000 bit/s from a 1 MS/s unsigned 8-bit baseband.",
  "settings": {
    "precision": "f32",
    "max_chunk": 4096
  },
  "inputs": {
    "rf": {
      "format": "cu8",
      "rate_hz": 1000000,
      "description": "IQ at 1 MS/s with the transmitter near 0 Hz"
    }
  },
  "nodes": {
    "dec": {
      "kind": "frame_decode"
    },
    "demod": {
      "kind": "ook_demod",
      "params": {
        "symbol_rate_hz": 2000
      }
    },
    "tune": {
      "kind": "ddc",
      "params": {
        "cutoff_hz": 15000,
        "decimation": 4,
        "transition_hz": 10000
      }
    }
  },
  "edges": [
    {
      "from": "rf",
      "to": "tune"
    },
    {
      "from": "tune",
      "to": "demod"
    },
    {
      "from": "demod",
      "to": "dec"
    },
    {
      "from": "dec",
      "to": "packets"
    }
  ],
  "outputs": {
    "packets": {
      "type": "packets",
      "queue": 64,
      "description": "The decoded packets with CRC_OK and the input index of their sync word"
    }
  }
}
