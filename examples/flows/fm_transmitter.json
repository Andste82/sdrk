{
  "sdrk": 1,
  "name": "fm-transmitter",
  "description": "Modulate 48 kHz audio to FM with pre-emphasis and a peak limiter and output a 2.4 MHz signed 8-bit baseband for a transmitter, in pull mode.",
  "settings": {
    "precision": "f32",
    "max_chunk": 4800
  },
  "inputs": {
    "audio": {
      "type": "f32",
      "rate_hz": 48000,
      "description": "mono audio"
    }
  },
  "nodes": {
    "duc": {
      "kind": "duc",
      "params": {
        "frequency_hz": 600000,
        "interpolation": 10
      }
    },
    "mod": {
      "kind": "fm_mod",
      "params": {
        "deviation_hz": 75000
      }
    },
    "shape": {
      "kind": "preemph_limit",
      "params": {
        "limit": 1.0,
        "preemphasis_us": 50
      }
    },
    "up": {
      "kind": "resample",
      "params": {
        "rate_out_hz": 240000
      }
    }
  },
  "edges": [
    {
      "from": "audio",
      "to": "up"
    },
    {
      "from": "up",
      "to": "shape"
    },
    {
      "from": "shape",
      "to": "mod"
    },
    {
      "from": "mod",
      "to": "duc"
    },
    {
      "from": "duc",
      "to": "rf"
    }
  ],
  "outputs": {
    "rf": {
      "type": "stream",
      "format": "cs8",
      "underrun": "zeros"
    }
  }
}
