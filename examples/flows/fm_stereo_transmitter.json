{
  "sdrk": 1,
  "name": "fm-stereo-transmitter",
  "description": "Modulate 48 kHz stereo audio (left in re, right in im) to FM stereo with pre-emphasis, a linked peak limiter, the 19 kHz pilot and the 38 kHz subcarrier, and output a 1.92 MHz signed 8-bit baseband for a transmitter, in pull mode.",
  "settings": {
    "precision": "f32",
    "max_chunk": 4800
  },
  "inputs": {
    "audio": {
      "type": "c32",
      "rate_hz": 48000,
      "description": "stereo audio (left in re, right in im)"
    }
  },
  "nodes": {
    "duc": {
      "kind": "duc",
      "params": {
        "frequency_hz": 600000,
        "interpolation": 10
      }
    },
    "mod": {
      "kind": "fm_mod",
      "params": {
        "deviation_hz": 75000
      }
    },
    "mpx": {
      "kind": "fm_stereo_mod",
      "params": {
        "main": 0.9,
        "pilot": 0.09,
        "pilot_hz": 19000
      }
    },
    "pre": {
      "kind": "preemph_limit",
      "params": {
        "limit": 1.0,
        "preemphasis_us": 50
      }
    },
    "up": {
      "kind": "resample",
      "params": {
        "rate_out_hz": 192000
      }
    }
  },
  "edges": [
    {
      "from": "audio",
      "to": "up"
    },
    {
      "from": "up",
      "to": "pre"
    },
    {
      "from": "pre",
      "to": "mpx"
    },
    {
      "from": "mpx",
      "to": "mod"
    },
    {
      "from": "mod",
      "to": "duc"
    },
    {
      "from": "duc",
      "to": "rf"
    }
  ],
  "outputs": {
    "rf": {
      "type": "stream",
      "format": "cs8",
      "underrun": "zeros"
    }
  }
}
