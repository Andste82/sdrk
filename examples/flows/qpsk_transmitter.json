{
  "sdrk": 1,
  "name": "qpsk-transmitter",
  "description": "Frame packets, modulate them as QPSK at 25 kBd with a root-raised-cosine pulse and output a 1 MHz signed 8-bit baseband for a transmitter, in pull mode.",
  "settings": {
    "precision": "f32",
    "max_chunk": 64
  },
  "inputs": {
    "msg": {
      "type": "packets",
      "rate_hz": 50000,
      "description": "Packets to send, up to 253 bytes each"
    }
  },
  "nodes": {
    "duc": {
      "kind": "duc",
      "params": {
        "cutoff_hz": 50000,
        "interpolation": 5,
        "transition_hz": 60000
      }
    },
    "enc": {
      "kind": "frame_encode",
      "params": {
        "idle": "preamble",
        "preamble_bytes": 4
      }
    },
    "level": {
      "kind": "scale",
      "params": {
        "gain_db": -3
      }
    },
    "mod": {
      "kind": "psk_mod",
      "params": {
        "order": 4,
        "rolloff": 0.35,
        "samples_per_symbol": 8,
        "span": 10
      }
    }
  },
  "edges": [
    {
      "from": "msg",
      "to": "enc"
    },
    {
      "from": "enc",
      "to": "mod"
    },
    {
      "from": "mod",
      "to": "level"
    },
    {
      "from": "level",
      "to": "duc"
    },
    {
      "from": "duc",
      "to": "rf"
    }
  ],
  "outputs": {
    "rf": {
      "type": "stream",
      "format": "cs8",
      "underrun": "zeros"
    }
  }
}
