{
  "sdrk": 1,
  "name": "fm-receiver",
  "description": "Receive one FM broadcast station and output 48 kHz audio.",
  "settings": {
    "precision": "f32",
    "max_chunk": 4096
  },
  "inputs": {
    "rf": {
      "format": "cu8",
      "rate_hz": 2400000,
      "description": "RTL-SDR IQ"
    }
  },
  "nodes": {
    "demod": {
      "kind": "fm_demod",
      "params": {
        "audio_decimation": 5,
        "deemphasis_us": 50,
        "deviation_hz": 75000
      }
    },
    "fft": {
      "kind": "spectrum",
      "params": {
        "averaging": 4,
        "fft_size": 1024
      }
    },
    "tune": {
      "kind": "ddc",
      "params": {
        "cutoff_hz": 100000,
        "decimation": 10,
        "frequency_hz": 600000
      }
    }
  },
  "edges": [
    {
      "from": "rf",
      "to": "tune"
    },
    {
      "from": "rf",
      "to": "fft"
    },
    {
      "from": "tune",
      "to": "demod"
    },
    {
      "from": "demod",
      "to": "audio"
    },
    {
      "from": "fft",
      "to": "spectrum"
    }
  ],
  "outputs": {
    "audio": {
      "type": "stream",
      "capacity": 16384,
      "drop": "error"
    },
    "spectrum": {
      "type": "frames",
      "queue": 4,
      "drop": "drop_oldest"
    }
  }
}
