+//===----------------------------------------------------------------------===//
+// SDRk: corrections of single instruction forms from uops.info measurements
+// (uops.info instructions.xml of 2026-03-29, SHA-256 e5e702ca...7ab3), the
+// one-time comparison of 2026-11-08. Each write names its source. Memory forms
+// keep the latency of this model; register forms take the measured latency.
+//===----------------------------------------------------------------------===//
+// SDRk: LEA with a scale other than 1 or with base, index and offset: uops.info ZEN2
+// LEA_B_IS (R64), LEA_B_I_D8 (R64), LEA_B_IS_D8 (R64): TP 0.50 (other forms 0.25). The
+// latency of 2 is the one the Znver3 model uses for the same forms (uops.info gives none).
+def SdrkZn2SlowLEAPredicate : MCSchedPredicate<
+  CheckAny<[
+    IsThreeOperandsLEAFn,
+    CheckAll<[
+      CheckIsImmOperand<2>,
+      CheckNot<CheckImmOperand<2, 1>>
+    ]>
+  ]>
+>;
+def SdrkZn2WriteSlowLEA : SchedWriteRes<[Zn2ALU]> {
+  let Latency = 2;
+  let ReleaseAtCycles = [2];
+  let NumMicroOps = 1;
+}
+def SdrkZn2WriteLEA : SchedWriteVariant<[
+    SchedVar<SdrkZn2SlowLEAPredicate, [SdrkZn2WriteSlowLEA]>,
+    SchedVar<NoSchedPred,             [WriteLEA]>
+]>;
+def : InstRW<[SdrkZn2WriteLEA], (instrs LEA32r, LEA64r, LEA64_32r)>;
+
 } // SchedModel
