{
  "sdrk": 1,
  "name": "gfsk-receiver",
  "description": "Receive GFSK packets at 50 kbit/s (deviation 25 kHz) from a 1 MS/s signed 16-bit baseband with automatic frequency control and the PN9-whitened test framing.",
  "settings": {
    "precision": "f32",
    "max_chunk": 4096
  },
  "inputs": {
    "rf": {
      "format": "cs16",
      "rate_hz": 1000000,
      "description": "IQ at 1 MS/s with the channel at 0 Hz"
    }
  },
  "nodes": {
    "afc": {
      "kind": "afc",
      "params": {
        "max_offset_hz": 20000
      }
    },
    "dec": {
      "kind": "frame_decode",
      "params": {
        "whitening": "pn9"
      }
    },
    "demod": {
      "kind": "fsk_demod",
      "params": {
        "deviation_hz": 25000,
        "symbol_rate_hz": 50000
      }
    },
    "tune": {
      "kind": "ddc",
      "params": {
        "cutoff_hz": 60000,
        "decimation": 5
      }
    }
  },
  "edges": [
    {
      "from": "rf",
      "to": "tune"
    },
    {
      "from": "tune",
      "to": "afc"
    },
    {
      "from": "afc",
      "to": "demod"
    },
    {
      "from": "demod",
      "to": "dec"
    },
    {
      "from": "dec",
      "to": "packets"
    }
  ],
  "outputs": {
    "packets": {
      "type": "packets",
      "queue": 256,
      "description": "The decoded packets with CRC_OK and the input sample index of their sync word"
    }
  }
}
