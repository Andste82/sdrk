{
  "sdrk": 1,
  "name": "fm-stereo-receiver-primitives",
  "description": "The FM stereo receiver built from primitives: the same audio as fm_stereo_demod, bit for bit.",
  "settings": {
    "precision": "f32",
    "max_chunk": 4096
  },
  "inputs": {
    "rf": {
      "format": "cs16",
      "rate_hz": 480000,
      "description": "FM broadcast baseband, 16-bit IQ, the station at 0 Hz"
    }
  },
  "nodes": {
    "deemph": {
      "kind": "deemphasis",
      "params": {
        "tau_us": 50
      }
    },
    "lpf": {
      "kind": "decimate",
      "params": {
        "attenuation_db": 60,
        "cutoff_hz": 15000,
        "factor": 5,
        "transition_hz": 3750
      }
    },
    "matrix": {
      "kind": "stereo_matrix"
    },
    "pilot": {
      "kind": "biquad",
      "params": {
        "cutoff_hz": 19000,
        "q": 5,
        "response": "bandpass"
      }
    },
    "pll": {
      "kind": "stereo_pll"
    },
    "quad": {
      "kind": "quad_demod",
      "params": {
        "deviation_hz": 75000
      }
    },
    "tune": {
      "kind": "ddc",
      "params": {
        "cutoff_hz": 100000,
        "decimation": 2,
        "frequency_hz": 0
      }
    }
  },
  "edges": [
    {
      "from": "rf",
      "to": "tune"
    },
    {
      "from": "tune",
      "to": "quad"
    },
    {
      "from": "quad",
      "to": "pll",
      "port": "a"
    },
    {
      "from": "quad",
      "to": "pilot"
    },
    {
      "from": "pilot",
      "to": "pll",
      "port": "b"
    },
    {
      "from": "pll",
      "to": "lpf"
    },
    {
      "from": "lpf",
      "to": "matrix"
    },
    {
      "from": "matrix",
      "to": "deemph"
    },
    {
      "from": "deemph",
      "to": "audio"
    }
  ],
  "outputs": {
    "audio": {
      "type": "stream",
      "capacity": 16384,
      "drop": "error"
    }
  }
}
